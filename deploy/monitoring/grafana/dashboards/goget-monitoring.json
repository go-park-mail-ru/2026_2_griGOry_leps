{
  "uid": "goget-monitoring",
  "title": "GoGet — Мониторинг",
  "tags": [
    "goget",
    "prometheus"
  ],
  "description": "HTTP-метрики сервисов auth, ads и search и ресурсы сервера.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "goget-prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"auth|ads|search|onlineconf\"}, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(up{job=~\"auth|ads|search|onlineconf\"}, job)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "label": "Метод",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "goget-prometheus"
        },
        "query": {
          "query": "label_values(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\"}, method)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\"}, method)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Маршрут",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "goget-prometheus"
        },
        "query": {
          "query": "label_values(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\"}, route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\"}, route)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Доступность источников метрик",
      "description": "UP — Prometheus получает метрики. DOWN — последняя попытка сбора не удалась.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "up{job=~\"auth|ads|search|onlineconf|node|prometheus\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "row",
      "title": "HTTP-запросы сервисов",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Запросы / с",
      "description": "Интенсивность запросов к каждому сервису с выбранными методом и маршрутом.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\",route=~\"${route}\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ошибки HTTP / с",
      "description": "Ответы 4xx и 5xx в секунду. Ноль показывается, когда есть метрики запросов, но соответствующих ошибок нет.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\",route=~\"${route}\",code=~\"4..\"}[$__rate_interval])) or (0 * sum by (job) (rate(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\",route=~\"${route}\"}[$__rate_interval])))",
          "legendFormat": "{{job}} · 4xx",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (job) (rate(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\",route=~\"${route}\",code=~\"5..\"}[$__rate_interval])) or (0 * sum by (job) (rate(goget_http_requests_total{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\",route=~\"${route}\"}[$__rate_interval])))",
          "legendFormat": "{{job}} · 5xx",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Время ответа p95",
      "description": "Оценка времени, быстрее которого завершились 95% запросов за окно расчёта.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(goget_http_request_duration_seconds_bucket{job=~\"auth|ads|search|onlineconf\",job=~\"${service}\",method=~\"${method}\",route=~\"${route}\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Ресурсы сервера",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU",
      "description": "Доля времени, когда ядра CPU не простаивают.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RAM",
      "description": "Доля оперативной памяти за вычетом MemAvailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Диск /",
      "description": "Занятость корневой файловой системы по доступному месту.",
      "datasource": {
        "type": "prometheus",
        "uid": "goget-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"})",
          "legendFormat": "{{mountpoint}} · {{instance}}",
          "range": true
        }
      ]
    }
  ]
}
