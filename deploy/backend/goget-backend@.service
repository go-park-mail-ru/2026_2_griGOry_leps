[Unit]
Description=GoGet backend (%i)
After=network.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/backend
EnvironmentFile=/home/ubuntu/backend/.env
EnvironmentFile=/etc/goget/backend.runtime.env
ExecStart=/opt/goget/backend/current/%i
Restart=always
RestartSec=3s
TimeoutStopSec=25s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027
