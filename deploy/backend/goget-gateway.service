[Unit]
Description=GoGet API gateway
Wants=goget-backend@auth.service goget-backend@ads.service goget-backend@search.service
After=network.target goget-backend@auth.service goget-backend@ads.service goget-backend@search.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/backend
EnvironmentFile=/home/ubuntu/backend/.env
EnvironmentFile=/etc/goget/backend.runtime.env
ExecStart=/opt/goget/backend/current/gateway
Restart=always
RestartSec=3s
TimeoutStopSec=25s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
